`timescale 1 ps/ 1 ps
module Testing_vlg_vec_tst();
// constants                                           
// general purpose registers
reg a;
reg b;
reg s;
// wires                                               
wire y;

// assign statements (if any)                          
Testing i1 (
// port map - connection between master ports and signals/registers   
	.a(a),
	.b(b),
	.s(s),
	.y(y)
);
initial 
begin 
#1000000 $stop;
end 

// a
initial
