reg CNT;
reg START_L;
// wires                                               
wire Y_L;
wire Z0;
wire Z1;

// assign statements (if any)                          
Practical1 i1 (
// port map - connection between master ports and signals/registers   
	.CLK(CLK),
	.CNT(CNT),
	.START_L(START_L),
	.Y_L(Y_L),
	.Z0(Z0),
	.Z1(Z1)
